# URL publique définitive du site (sans barre oblique finale).
# Utilisée pour les balises canoniques, le sitemap et les aperçus de partage.
PUBLIC_SITE_URL=https://brayano-service.vercel.app

# Mode démonstration (actif par défaut) : affiche les contenus d'exemple (témoignages, prix, FAQ
# provisoires) avec une étiquette « Exemple » et un bandeau, et retire les pages de Google.
# Passer à false pour publier le site sans aucun contenu fictif.
PUBLIC_SHOW_DRAFTS=true
