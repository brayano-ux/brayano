# URL publique définitive du site (sans barre oblique finale).
# Utilisée pour les balises canoniques, le sitemap et les aperçus de partage.
PUBLIC_SITE_URL=https://brayano-service.vercel.app

# Mode démonstration : affiche les contenus d'exemple (témoignages, prix, FAQ provisoires) avec une
# étiquette « Exemple » et un bandeau. À laisser à false sur le site public.
PUBLIC_SHOW_DRAFTS=false
