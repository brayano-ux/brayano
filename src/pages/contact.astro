---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { whatsappLink } from '@/lib/whatsapp';
---

<Base
  title="Contact et demande de devis · Brayano Service"
  description="Présentez votre projet à Brayano Service : WhatsApp, e-mail ou formulaire de demande de devis. Réponse personnelle du fondateur."
>
  <PageHero
    eyebrow="Contact"
    title="Présentez-moi votre projet."
    lead="Le plus rapide reste WhatsApp. Si vous préférez structurer votre demande, le formulaire prépare le message pour vous."
  />

  <section class="section">
    <div class="container contact">
      <div class="contact__form">
        <h2 class="contact__title">Demande de devis</h2>
        <QuoteForm />
      </div>

      <aside class="contact__side" aria-label="Coordonnées">
        <div class="contact__card">
          <h2>Écrire directement</h2>
          <a class="btn btn--whatsapp" href={whatsappLink('general')} target="_blank" rel="noopener" data-track="whatsapp" data-track-origin="contact">
            <Icon name="whatsapp" />
            Discuter sur WhatsApp
          </a>
          <dl>
            <div><dt>WhatsApp et téléphone</dt><dd><a href={`tel:+${site.contact.phoneCountryCode}${site.contact.phoneLocal}`}>{site.contact.phoneDisplay}</a></dd></div>
            <div><dt>E-mail</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
            <div><dt>Localisation</dt><dd>{site.city}, {site.country}</dd></div>
          </dl>
        </div>
        <div class="contact__card">
          <h2>Ce qui se passe ensuite</h2>
          <ol class="contact__steps">
            <li>Je lis votre message et je vous réponds personnellement.</li>
            <li>On échange pour préciser le besoin, par message ou par appel.</li>
            <li>Vous recevez une proposition : contenu, délai et prix.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: var(--space-7); align-items: start; }
  .contact__title { font-size: var(--step-2); margin-bottom: var(--space-5); }
  .contact__side { display: grid; gap: var(--space-5); }
  .contact__card { display: grid; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--bg-raised); }
  .contact__card h2 { font-size: var(--step-1); }
  .contact__card dl { display: grid; margin: 0; }
  .contact__card dl > div { display: grid; gap: 0.15rem; padding-block: var(--space-3); border-top: 1px solid var(--line); }
  .contact__card dt { font-size: 0.78rem; color: var(--text-dim); }
  .contact__card dd { margin: 0; }
  .contact__card dd a { display: inline-block; padding-block: 0.2rem; text-underline-offset: 4px; }
  .contact__steps { display: grid; gap: var(--space-3); padding-left: 1.3rem; list-style: decimal; color: var(--text-muted); font-size: 0.96rem; }
  .contact__steps li::marker { color: var(--cyan); font-family: var(--font-display); }
  @media (min-width: 62rem) {
    .contact { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: var(--space-8); }
    .contact__side { position: sticky; top: calc(var(--header-h) + 2rem); margin-top: calc(var(--step-2) * 1.1 + var(--space-5)); }
  }
</style>
