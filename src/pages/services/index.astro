---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import CtaBand from '@/components/CtaBand.astro';
import Process from '@/components/Process.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/services';
---

<Base
  title="Services · Brayano Service"
  description="Création de sites web, publicité Facebook et Instagram, développement logiciel, automatisation et IA, visibilité sur Google, formation pratique en IA."
>
  <PageHero
    eyebrow="Services"
    title="Ce que je peux faire pour votre entreprise."
    lead="Six services qui se complètent : être trouvé, être contacté, bien répondre, gagner du temps. Vous pouvez en choisir un seul ou les combiner."
  />

  <section class="section">
    <div class="container">
      <ul class="rows">
        {services.map((service, index) => (
          <li class="row" data-reveal>
            <div class="row__visual"><Photo name={service.slug} sizes="(min-width: 52rem) 26rem, 92vw" /></div>
            <div class="row__body">
              <p class="row__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
              <h2><a href={service.path}>{service.title}</a></h2>
              <p class="muted">{service.intro}</p>
              <ul class="row__offers">
                {service.offers.map((offer) => <li class="tag">{offer.title}</li>)}
              </ul>
              <span class="link-arrow" aria-hidden="true">Découvrir ce service <Icon name="arrow" /></span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Process />
  <CtaBand />
</Base>

<style>
  .rows { display: grid; gap: var(--space-5); }
  .row {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: border-color var(--dur);
  }
  .row:hover, .row:focus-within { border-color: rgb(37 99 235 / 0.55); }
  .row__visual { border-radius: var(--radius-m); overflow: hidden; align-self: stretch; }
  .row__visual :global(.photo) { height: 100%; min-height: 12rem; }
  .row__body { display: grid; gap: var(--space-3); align-content: start; justify-items: start; }
  .row__index { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--text-dim); }
  .row h2 { font-size: var(--step-2); }
  .row h2 a { text-decoration: none; }
  .row h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .row__offers { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block: var(--space-2); }
  .row:hover .link-arrow :global(svg) { transform: translateX(4px); }
  @media (prefers-reduced-motion: no-preference) {
    .row:hover :global(.photo img), .row:focus-within :global(.photo img) { transform: scale(1.04); }
  }
  @media (min-width: 52rem) {
    .row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr); gap: var(--space-7); padding: var(--space-6); align-items: center; }
    .row:nth-child(even) .row__visual { order: 2; }
    .row:nth-child(even) { grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr); }
  }
</style>
