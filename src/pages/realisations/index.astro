---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { publishedProjects } from '@/data/projects';
---

<Base
  title="Réalisations et études de cas · Brayano Service"
  description="Sites web, produit logiciel et campagne publicitaire réalisés par Brayano Service : contexte, solution, captures et résultats documentés."
>
  <PageHero
    eyebrow="Réalisations"
    title="Des projets que vous pouvez ouvrir et vérifier."
    lead="Pour chaque réalisation : le besoin de départ, ce qui a été construit et, lorsqu’ils sont documentés, les résultats mesurés. Rien d’autre."
  />

  <section class="section">
    <div class="container">
      <ul class="list">
        {publishedProjects.map((project) => (
          <li data-reveal><ProjectCard project={project} wide heading="h2" /></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Votre projet pourrait être le prochain." />
</Base>

<style>
  .list { display: grid; gap: var(--space-5); }
</style>
