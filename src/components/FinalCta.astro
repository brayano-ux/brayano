---
import Icon from './Icon.astro';
import { site } from '@/config/site';
import { whatsappLink } from '@/lib/whatsapp';

// Jalon 1 : la demande de devis part par e-mail. Elle pointera vers le formulaire de /contact au jalon suivant.
const quoteHref = `mailto:${site.contact.email}?subject=${encodeURIComponent('Demande de devis')}`;
---

<section class="section cta" aria-labelledby="cta-titre">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div class="cta__glow" aria-hidden="true"></div>
      <h2 id="cta-titre">Parlons de votre prochain projet.</h2>
      <p class="lead">
        Vous souhaitez améliorer votre visibilité, automatiser certaines tâches ou développer une solution numérique ?
        Présentez-nous votre besoin : la première discussion ne vous engage à rien.
      </p>
      <div class="cta__actions">
        <a class="btn btn--whatsapp" href={whatsappLink('general')} target="_blank" rel="noopener" data-track="whatsapp" data-track-origin="cta-final">
          <Icon name="whatsapp" />
          Démarrer sur WhatsApp
        </a>
        <a class="btn btn--ghost" href={quoteHref} data-track="devis" data-track-origin="cta-final">
          <Icon name="mail" />
          Demander un devis par e-mail
        </a>
      </div>
      <p class="cta__contact">{site.contact.phoneDisplay} · {site.contact.email}</p>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
    padding: clamp(2.75rem, 2rem + 5vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius-l) * 1.4);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    overflow: hidden;
    isolation: isolate;
  }
  .cta__glow {
    position: absolute;
    inset: auto -10% -70% -10%;
    height: 120%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(61 134 255 / 0.4), rgb(130 114 255 / 0.12) 55%, transparent 75%);
  }
  .cta__panel .lead { max-width: 40rem; }
  .cta__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-2); }
  .cta__contact { font-size: 0.88rem; color: var(--text-muted); }
  @media (max-width: 30rem) {
    .cta__actions { width: 100%; }
    .cta__actions .btn { flex: 1 1 100%; }
  }
</style>
