---
/**
 * Visuel du hero : une photo, sur laquelle flotte un extrait de conversation.
 * La conversation est une illustration et est signalée comme telle.
 */
import Photo from './Photo.astro';
---

<figure class="hv" data-inview>
  <div class="hv__photo">
    <Photo name="hero" sizes="(min-width: 62rem) 36rem, 92vw" ratio="5 / 4" eager />
  </div>

  <div class="hv__chat">
    <p class="hv__chat-head"><i></i>Assistant IA · WhatsApp</p>
    <p class="hv__bubble hv__bubble--in">Vous livrez à Akwa&nbsp;?</p>
    <p class="hv__bubble hv__bubble--out">Oui, livraison possible aujourd’hui.</p>
    <p class="demo-label">Illustration</p>
  </div>

  <ul class="hv__chips" aria-hidden="true">
    <li>Sites web</li>
    <li>Publicité</li>
    <li>IA</li>
    <li>Logiciels</li>
  </ul>
</figure>

<style>
  .hv { position: relative; margin: 0; width: 100%; max-width: 36rem; justify-self: center; padding: 0 0 2.75rem 1.5rem; }
  .hv::before {
    content: '';
    position: absolute;
    inset: 12% -4% 4% 10%;
    border-radius: var(--radius-l);
    background: linear-gradient(140deg, rgb(37 99 235 / 0.16), rgb(109 93 246 / 0.12));
    transform: rotate(3deg);
  }
  .hv__photo { position: relative; border-radius: var(--radius-l); overflow: hidden; box-shadow: var(--shadow-float); }

  .hv__chat {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(17rem, 72%);
    display: grid;
    gap: 0.45rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }
  .hv__chat-head { display: flex; align-items: center; gap: 0.45rem; font-family: var(--font-display); font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .hv__chat-head i { width: 7px; height: 7px; border-radius: 50%; background: var(--whatsapp); }
  .hv__bubble { max-width: 90%; padding: 0.45rem 0.7rem; border-radius: 0.8rem; font-size: 0.82rem; line-height: 1.35; }
  .hv__bubble--in { background: var(--bg-raised); border-bottom-left-radius: 0.2rem; }
  .hv__bubble--out { justify-self: end; background: #dcf8e6; color: #06301a; border-bottom-right-radius: 0.2rem; }
  .hv__chat .demo-label { font-size: 0.58rem; }

  .hv__chips { position: absolute; right: 0.75rem; top: 0.75rem; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.35rem; max-width: 60%; }
  .hv__chips li { padding: 0.3rem 0.65rem; border-radius: var(--radius-pill); background: rgb(255 255 255 / 0.92); font-family: var(--font-display); font-size: 0.68rem; font-weight: 600; color: var(--text); box-shadow: 0 4px 14px -6px rgb(13 38 89 / 0.5); }

  @media (prefers-reduced-motion: no-preference) {
    .hv.is-in .hv__chat { animation: hv-float 8s ease-in-out infinite; }
  }
  @keyframes hv-float {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -8px, 0); }
  }
  /* Sur petit écran, la bulle descend sous la photo pour ne pas masquer le sujet. */
  @media (max-width: 40rem) {
    .hv { padding: 0 0 6.25rem 0.75rem; }
    .hv__chat { width: min(15rem, 68%); padding: 0.7rem; }
    .hv__chips { max-width: 80%; }
  }
</style>
