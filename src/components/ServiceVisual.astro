---
import type { Service } from '@/data/services';
interface Props { slug: Service['slug'] }
const { slug } = Astro.props;
---

<svg class="sv" viewBox="0 0 200 96" fill="none" aria-hidden="true">
  {slug === 'sites-web' && (
    <g>
      <rect x="34" y="12" width="132" height="76" rx="8" class="sv-line" />
      <path d="M34 28h132" class="sv-line" />
      <circle cx="44" cy="20" r="2" class="sv-dot" /><circle cx="52" cy="20" r="2" class="sv-dot" />
      <rect x="46" y="40" width="50" height="6" rx="3" class="sv-fill" />
      <rect x="46" y="52" width="36" height="4" rx="2" class="sv-soft" />
      <rect x="46" y="66" width="28" height="10" rx="5" class="sv-accent sv-move" />
      <rect x="110" y="38" width="44" height="38" rx="5" class="sv-soft" />
    </g>
  )}
  {slug === 'publicite' && (
    <g>
      <circle cx="100" cy="48" r="38" class="sv-line" opacity=".45" />
      <circle cx="100" cy="48" r="24" class="sv-line" opacity=".7" />
      <circle cx="100" cy="48" r="9" class="sv-accent sv-pulse" />
      <circle cx="62" cy="34" r="3" class="sv-dot" /><circle cx="140" cy="30" r="3" class="sv-dot" />
      <circle cx="134" cy="70" r="3" class="sv-fill" /><circle cx="70" cy="68" r="3" class="sv-dot" />
      <path d="M134 70 109 53" class="sv-line sv-dash" />
    </g>
  )}
  {slug === 'logiciels' && (
    <g>
      <rect x="38" y="16" width="52" height="28" rx="6" class="sv-line" />
      <rect x="110" y="16" width="52" height="28" rx="6" class="sv-soft" />
      <rect x="74" y="58" width="52" height="26" rx="6" class="sv-accent sv-move" />
      <path d="M64 44v8a6 6 0 0 0 6 6h4M136 44v8a6 6 0 0 1-6 6h-4" class="sv-line" />
      <path d="M48 28h20M48 34h12" class="sv-line" opacity=".6" />
    </g>
  )}
  {slug === 'automatisation-ia' && (
    <g>
      <circle cx="44" cy="22" r="7" class="sv-line" /><circle cx="44" cy="48" r="7" class="sv-line" /><circle cx="44" cy="74" r="7" class="sv-line" />
      <path d="M51 22c30 0 26 26 50 26M51 48h50M51 74c30 0 26-26 50-26" class="sv-line sv-dash" />
      <circle cx="112" cy="48" r="12" class="sv-accent sv-pulse" />
      <path d="M124 48h22" class="sv-line" />
      <rect x="146" y="38" width="22" height="20" rx="5" class="sv-soft" />
      <path d="m152 48 4 4 7-8" class="sv-line" />
    </g>
  )}
  {slug === 'visibilite-google' && (
    <g>
      <path d="M30 70h140M30 50h140M30 30h140M60 14v72M100 14v72M140 14v72" class="sv-line" opacity=".3" />
      <path d="M100 74s-18-17-18-31a18 18 0 1 1 36 0c0 14-18 31-18 31Z" class="sv-accent sv-move" />
      <circle cx="100" cy="43" r="6" fill="#060a13" />
      <rect x="126" y="56" width="38" height="22" rx="5" class="sv-soft" />
      <path d="M132 64h20M132 70h12" class="sv-line" opacity=".7" />
    </g>
  )}
  {slug === 'formation-ia' && (
    <g>
      <rect x="42" y="14" width="116" height="62" rx="8" class="sv-line" />
      <path d="M30 86h140" class="sv-line" />
      <path d="m58 34 5 5 9-10" class="sv-line" /><rect x="80" y="31" width="52" height="5" rx="2.5" class="sv-fill" />
      <path d="m58 54 5 5 9-10" class="sv-line" /><rect x="80" y="51" width="36" height="5" rx="2.5" class="sv-soft" />
      <rect x="126" y="48" width="18" height="12" rx="6" class="sv-accent sv-pulse" />
    </g>
  )}
</svg>

<style>
  .sv { width: 100%; height: auto; }
  .sv-line { stroke: var(--line-strong); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: stroke var(--dur); }
  .sv-dash { stroke-dasharray: 3 6; }
  .sv-dot { fill: var(--text-dim); }
  .sv-fill { fill: rgb(238 241 247 / 0.75); }
  .sv-soft { fill: rgb(150 172 255 / 0.1); stroke: var(--line); }
  .sv-accent { fill: var(--accent); transition: fill var(--dur), transform var(--dur-slow) var(--ease-out); transform-box: fill-box; transform-origin: center; }
</style>
