---
import { Image } from 'astro:assets';
import type { ProjectImage } from '@/data/projects';

interface Props {
  image: ProjectImage;
  url?: string;
  sizes: string;
  eager?: boolean;
  /** Affiche la capture entière au lieu de la recadrer en 16:10. */
  full?: boolean;
}
const { image, url, sizes, eager = false, full = false } = Astro.props;
---

<div class:list={['frame', { 'frame--full': full }]}>
  <div class="frame__chrome" aria-hidden="true">
    <i></i><i></i><i></i>
    {url && <span>{new URL(url).hostname}</span>}
  </div>
  <Image
    src={image.src}
    alt={image.alt}
    widths={[480, 760, 1100, 1440]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .frame { background: var(--bg); overflow: hidden; }
  .frame__chrome { display: flex; align-items: center; gap: 6px; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--line); background: var(--surface-2); }
  .frame__chrome i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .frame__chrome span { margin-left: 0.6rem; font-size: 0.72rem; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .frame :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; transition: transform 900ms var(--ease-out); }
  .frame--full :global(img) { aspect-ratio: auto; }
</style>
