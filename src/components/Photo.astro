---
import { Image } from 'astro:assets';
import { photos, type PhotoKey } from '@/data/photos';

interface Props {
  name: PhotoKey;
  /** Attribut sizes, selon la largeur réellement occupée dans la mise en page. */
  sizes: string;
  /** Proportions du cadre, par exemple « 3 / 2 ». */
  ratio?: string;
  eager?: boolean;
}
const { name, sizes, ratio = '3 / 2', eager = false } = Astro.props;
const photo = photos[name];
---

<div
  class:list={['photo', { 'photo--empty': !photo, 'photo--contain': photo?.fit === 'contain' }]}
  style={`aspect-ratio: ${ratio};${photo?.background ? ` background: ${photo.background};` : ''}`}
>
  {photo && (
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={[360, 560, 800, 1120, 1440]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  )}
</div>

<style>
  .photo { width: 100%; overflow: hidden; border-radius: inherit; background: var(--surface-2); }
  .photo--empty { background: linear-gradient(140deg, var(--surface-2), rgb(37 99 235 / 0.16)); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .photo.photo--contain :global(img) { object-fit: contain; }
</style>
