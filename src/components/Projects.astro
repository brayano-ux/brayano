---
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import { featuredProjects } from '@/data/projects';
---

<section class="section" id="realisations" aria-labelledby="realisations-titre">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Réalisations</p>
      <h2 id="realisations-titre">Des projets en ligne, pas des promesses.</h2>
      <p class="lead">Chaque site ci-dessous est accessible : ouvrez-le, parcourez-le, jugez par vous-même.</p>
    </div>

    <ul class="projects">
      {featuredProjects.map((project, index) => (
        <li class:list={{ 'projects__wide': index === 0 || project.type === 'campagne' }} data-reveal style={`--i:${index % 2}`}>
          <ProjectCard project={project} wide={index === 0} />
        </li>
      ))}
    </ul>

    <p class="projects__more" data-reveal>
      <a class="btn btn--ghost" href="/realisations">Toutes les réalisations <Icon name="arrow" /></a>
    </p>
  </div>
</section>

<style>
  .projects { display: grid; gap: var(--space-5); }
  .projects__more { margin-top: var(--space-6); }
  @media (min-width: 62rem) {
    .projects { grid-template-columns: 1fr 1fr; }
    .projects__wide { grid-column: 1 / -1; }
  }
</style>
