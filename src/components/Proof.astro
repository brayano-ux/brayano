---
import { Image } from 'astro:assets';
import portrait from '@/assets/equipe/brayano.jpg';
import { site } from '@/config/site';
import { publishedProjects, getProject, projectPath } from '@/data/projects';

const sites = publishedProjects.filter((project) => project.url);
const campaign = getProject('campagne-pure-molecule');
---

<section class="proof" aria-label="Éléments de preuve">
  <div class="container">
    <ul class="proof__grid">
      <li data-reveal style="--i:0">
        <p class="proof__value">{sites.length}</p>
        <p class="proof__label">réalisations en ligne, que vous pouvez ouvrir et tester vous-même.</p>
        <a class="proof__link" href="/realisations">Voir les réalisations</a>
      </li>
      {campaign && (
        <li data-reveal style="--i:1">
          <p class="proof__value">{campaign.metrics[0]?.value}</p>
          <p class="proof__label">
            conversations WhatsApp démarrées en 30 jours par une campagne Meta, à {campaign.metrics[1]?.value} l’unité.
          </p>
          <p class="proof__note">Une conversation démarrée est une prise de contact, pas une vente.</p>
          <a class="proof__link" href={projectPath(campaign)}>Lire l’étude de cas</a>
        </li>
      )}
      <li data-reveal style="--i:2">
        <p class="proof__value proof__value--text">Brayano IA</p>
        <p class="proof__label">Mon propre produit : conçu, développé et exploité par mes soins.</p>
        <a class="proof__link" href="/brayano-ia">Découvrir le produit</a>
      </li>
      <li class="proof__person" data-reveal style="--i:3">
        <Image src={portrait} alt={`Portrait de ${site.founder.fullName}`} width={72} height={72} densities={[1, 2]} fit="cover" position="top" loading="eager" />
        <div>
          <p class="proof__name">{site.founder.fullName}</p>
          <p class="proof__label">{site.founder.role}. Votre interlocuteur du premier message à la livraison.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .proof { border-block: 1px solid var(--line); background: var(--bg-raised); }
  .proof__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .proof__grid > li { display: grid; gap: 0.5rem; align-content: start; padding: var(--space-6) 0; border-top: 1px solid var(--line); }
  .proof__grid > li:first-child { border-top: 0; }
  .proof__value { font-family: var(--font-display); font-size: var(--step-3); font-weight: 600; letter-spacing: -0.04em; line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; }
  .proof__value--text { font-size: var(--step-2); line-height: 1.25; }
  .proof__label { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }
  .proof__note { color: var(--text-dim); font-size: 0.78rem; line-height: 1.45; }
  .proof__link { justify-self: start; padding-block: 0.3rem; font-size: 0.88rem; color: var(--highlight); text-underline-offset: 4px; }
  .proof__person { grid-template-columns: auto 1fr; gap: var(--space-4) !important; align-items: center; }
  .proof__person :global(img) { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; border: 1px solid var(--line-strong); }
  .proof__name { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; line-height: 1.3; margin-bottom: 0.25rem; }

  @media (min-width: 40rem) {
    .proof__grid > li { padding: var(--space-6) var(--space-5); border-top: 0; border-left: 1px solid var(--line); }
    .proof__grid > li:first-child { padding-left: 0; border-left: 0; }
  }
</style>
