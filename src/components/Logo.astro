---
/**
 * Logo de Brayano Service : le symbole officiel de Brayano IA (choix du fondateur)
 * accompagné du nom de l'entreprise.
 */
import { Image } from 'astro:assets';
import mark from '@/assets/marque/logo-mark.png';
import { site } from '@/config/site';
---

<span class="logo">
  <Image class="logo__mark" src={mark} alt="" width={38} height={36} densities={[1, 2, 3]} loading="eager" />
  <span class="logo__text">Brayano<span class="logo__sub">Service</span></span>
  <span class="visually-hidden"> — {site.name}, accueil</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo :global(.logo__mark) { width: 2.35rem; height: auto; flex: none; }
  .logo__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }
  .logo__sub { margin-left: 0.3em; font-weight: 400; color: var(--text-muted); }
</style>
