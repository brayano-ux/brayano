---
import Icon from './Icon.astro';
import { site, type WhatsAppIntent } from '@/config/site';
import { whatsappLink } from '@/lib/whatsapp';

interface Props {
  title?: string;
  text?: string;
  intent?: WhatsAppIntent;
  primaryLabel?: string;
  /** Slug de service transmis au formulaire de devis pour présélection. */
  service?: string;
  origin?: string;
}
const {
  title = 'Parlons de votre prochain projet.',
  text = 'Vous souhaitez améliorer votre visibilité, automatiser certaines tâches ou développer une solution numérique ? Présentez-moi votre besoin : la première discussion ne vous engage à rien.',
  intent = 'general',
  primaryLabel = 'Démarrer sur WhatsApp',
  service,
  origin = 'cta-final',
} = Astro.props;
const quoteHref = service ? `/contact?service=${service}` : '/contact';
---

<section class="section cta" aria-labelledby="cta-titre">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div class="cta__glow" aria-hidden="true"></div>
      <h2 id="cta-titre">{title}</h2>
      <p class="lead">{text}</p>
      <div class="cta__actions">
        <a class="btn btn--whatsapp" href={whatsappLink(intent)} target="_blank" rel="noopener" data-track="whatsapp" data-track-origin={origin}>
          <Icon name="whatsapp" />
          {primaryLabel}
        </a>
        <a class="btn btn--ghost" href={quoteHref}>
          Demander un devis
          <Icon name="arrow" />
        </a>
      </div>
      <p class="cta__contact">{site.contact.phoneDisplay} · {site.contact.email}</p>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
    padding: clamp(2.75rem, 2rem + 5vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius-l) * 1.4);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    overflow: hidden;
    isolation: isolate;
  }
  .cta__glow {
    position: absolute;
    inset: auto -10% -70% -10%;
    height: 120%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(77 147 255 / 0.5), rgb(92 220 255 / 0.12) 55%, transparent 75%);
  }
  .cta__panel .lead { max-width: 40rem; }
  .cta__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-2); }
  .cta__contact { font-size: 0.88rem; color: var(--text-muted); }
  @media (max-width: 30rem) {
    .cta__actions { width: 100%; }
    .cta__actions .btn { flex: 1 1 100%; }
  }
</style>
